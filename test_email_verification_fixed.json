{
    "testName": "Email Verification Fix Test",
    "description": "Test email verification sau khi fix template path issue",
    "fixed_issue": {
        "problem": "Template path không đúng - đang tìm 'verification' thay vì 'email/verification'",
        "solution": "Fixed EmailTemplate enum để include đúng path: email/verification",
        "changed_files": [
            "EmailService.java - Updated template paths",
            "password-reset.html - Created missing template"
        ]
    },
    "test_steps": [
        {
            "step": 1,
            "description": "Test Registration với Debug Endpoint",
            "endpoint": "POST /cinema/api/auth/test-registration",
            "method": "POST",
            "headers": {
                "Content-Type": "application/json"
            },
            "body": {
                "username": "testuser12345",
                "email": "testuser12345@gmail.com",
                "password": "12345Aa!",
                "confirmPassword": "12345Aa!",
                "fullName": "Test Email Verification User",
                "phoneNumber": "0987654321",
                "dateOfBirth": "1995-01-01",
                "address": "123 Test Street",
                "agreeToTerms": true,
                "acceptMarketing": false
            },
            "expected_result": {
                "registration_successful": true,
                "email_verification_sent": true,
                "logs_should_show": [
                    "✅ Template processed successfully",
                    "✅ HTML email sent successfully",
                    "✅ Verification email sent successfully"
                ],
                "logs_should_NOT_show": [
                    "❌ Error resolving template [verification]",
                    "❌ EmailService returned false"
                ]
            }
        },
        {
            "step": 2,
            "description": "Test Verification Email Template Direct",
            "endpoint": "POST /cinema/api/emails/test/verification",
            "method": "POST",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{ADMIN_TOKEN}}"
            },
            "body": {
                "to": "gundn.contact@gmail.com",
                "customerName": "Test Direct Template",
                "token": "test-token-direct-123"
            },
            "expected_result": {
                "success": true,
                "email_sent": true
            }
        }
    ],
    "instructions": "Thay {{TIMESTAMP}} bằng timestamp thực tế để tránh duplicate email/username",
    "admin_login": {
        "note": "Cần login admin trước để lấy token cho test step 2",
        "endpoint": "POST /cinema/api/auth/login",
        "credentials": {
            "username": "admin",
            "password": "admin_password"
        }
    }
}