# 🎬 Movie Theater Management System - Environment Variables
# Copy this file to .env and update the values

# Database Configuration
MYSQL_ROOT_PASSWORD=12345Aa
MYSQL_DATABASE=cinema_db
MYSQL_USER=cinema_user
MYSQL_PASSWORD=cinema_password

# Application Configuration
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# JWT Configuration
JWT_SECRET=movieTheaterSecretKey2025ForJWTTokenGenerationInDocker

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=lumierecinema25@gmail.com
MAIL_PASSWORD=jstdgruqurruswtc
EMAIL_FROM=lumierecinema25@gmail.com
EMAIL_FROM_NAME=Lumière Cinema
EMAIL_VERIFICATION_BASE_URL=https://lumierecinema.vn

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# File Upload Configuration
MAX_FILE_SIZE=10MB
UPLOAD_DIR=uploads/

# Logging Level
LOG_LEVEL=INFO

# Docker Registry (for CI/CD)
DOCKER_REGISTRY=registry.gitlab.com/your-group/movie-theater
DOCKER_IMAGE_TAG=latest

# Deployment Configuration
ENVIRONMENT=development
DOMAIN=localhost

# Monitoring Configuration
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true 